# Arc Testnet ERC-8004 quickstart — Circle developer-controlled wallets
# Copy to .env (never commit .env).
CIRCLE_API_KEY=YOUR_API_KEY
# Leave blank and run `npm run entity-secret` to generate + register one.
# If you already registered an entity secret in the Circle Console, paste it here instead.
CIRCLE_ENTITY_SECRET=
# Optional: your own IPFS metadata URI (Step 3). Defaults to the docs example URI.
# METADATA_URI=ipfs://bafkreibdi6623n3xpf7ymk62ckb4bo75o3qemwkpfvp5i25j66itxvsoei
# Optional: reuse existing Arc Testnet dev-controlled wallets instead of creating new ones each run.
# OWNER_WALLET_ADDRESS=0x...
# VALIDATOR_WALLET_ADDRESS=0x...
