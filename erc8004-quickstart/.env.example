# Arc Testnet ERC-8004 quickstart
# Copy to .env (never commit .env). Generate throwaway keys with: npm run wallets
OWNER_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY
VALIDATOR_PRIVATE_KEY=0xYOUR_VALIDATOR_PRIVATE_KEY
